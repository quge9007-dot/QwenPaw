<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qwenpaw.usermanagement.dao.mapper.UserAttributeMapper">

    <resultMap id="UserAttributeResultMap" type="UserAttributeDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="VARCHAR"/>
        <result column="attr_key" property="attrKey" jdbcType="VARCHAR"/>
        <result column="attr_value" property="attrValue" jdbcType="VARCHAR"/>
        <result column="attr_type" property="attrType" jdbcType="INTEGER"/>
        <result column="pk_id" property="pkId" jdbcType="VARCHAR"/>
        <result column="gmt_create" property="gmtCreate" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="UserAttributeDO">
        INSERT INTO user_attribute (user_id, attr_key, attr_value, attr_type, pk_id, gmt_create, gmt_modified)
        VALUES (#{userId}, #{attrKey}, #{attrValue}, #{attrType}, #{pkId}, #{gmtCreate}, #{gmtModified})
    </insert>

    <update id="updateById" parameterType="UserAttributeDO">
        UPDATE user_attribute SET attr_value = #{attrValue}, attr_type = #{attrType}, gmt_modified = #{gmtModified}
        WHERE user_id = #{userId} AND attr_key = #{attrKey}
    </update>

    <select id="selectByUserIdAndKey" resultMap="UserAttributeResultMap">
        SELECT * FROM user_attribute WHERE user_id = #{userId} AND attr_key = #{attrKey}
    </select>

    <select id="selectByUserId" resultMap="UserAttributeResultMap">
        SELECT * FROM user_attribute WHERE user_id = #{userId}
    </select>

</mapper>
