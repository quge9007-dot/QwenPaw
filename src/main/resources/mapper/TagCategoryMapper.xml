<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qwenpaw.usermanagement.dao.mapper.TagCategoryMapper">

    <resultMap id="TagCategoryResultMap" type="TagCategoryDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="category_id" property="categoryId" jdbcType="VARCHAR"/>
        <result column="category_name" property="categoryName" jdbcType="VARCHAR"/>
        <result column="parent_id" property="parentId" jdbcType="BIGINT"/>
        <result column="sort_order" property="sortOrder" jdbcType="INTEGER"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="pk_id" property="pkId" jdbcType="VARCHAR"/>
        <result column="gmt_create" property="gmtCreate" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="TagCategoryDO">
        INSERT INTO tag_category (category_id, category_name, parent_id, sort_order, status, pk_id, gmt_create, gmt_modified)
        VALUES (#{categoryId}, #{categoryName}, #{parentId}, #{sortOrder}, #{status}, #{pkId}, #{gmtCreate}, #{gmtModified})
    </insert>

    <update id="updateById" parameterType="TagCategoryDO">
        UPDATE tag_category SET category_name = #{categoryName}, parent_id = #{parentId}, sort_order = #{sortOrder}, status = #{status}, gmt_modified = #{gmtModified}
        WHERE category_id = #{categoryId}
    </update>

    <delete id="deleteById">
        DELETE FROM tag_category WHERE category_id = #{categoryId}
    </delete>

    <select id="selectById" resultMap="TagCategoryResultMap">
        SELECT * FROM tag_category WHERE category_id = #{categoryId}
    </select>

    <select id="selectAll" resultMap="TagCategoryResultMap">
        SELECT * FROM tag_category ORDER BY sort_order ASC
    </select>

    <select id="selectByParentId" resultMap="TagCategoryResultMap">
        SELECT * FROM tag_category WHERE parent_id = #{parentId} ORDER BY sort_order ASC
    </select>

</mapper>
