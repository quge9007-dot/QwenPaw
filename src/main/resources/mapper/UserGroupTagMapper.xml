<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qwenpaw.usermanagement.dao.mapper.UserGroupTagMapper">

    <resultMap id="UserGroupTagResultMap" type="UserGroupTagDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="group_id" property="groupId" jdbcType="VARCHAR"/>
        <result column="tag_id" property="tagId" jdbcType="VARCHAR"/>
        <result column="match_mode" property="matchMode" jdbcType="INTEGER"/>
        <result column="sort_order" property="sortOrder" jdbcType="INTEGER"/>
        <result column="pk_id" property="pkId" jdbcType="VARCHAR"/>
        <result column="gmt_create" property="gmtCreate" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="UserGroupTagDO">
        INSERT INTO user_group_tag (group_id, tag_id, match_mode, sort_order, pk_id, gmt_create, gmt_modified)
        VALUES (#{groupId}, #{tagId}, #{matchMode}, #{sortOrder}, #{pkId}, #{gmtCreate}, #{gmtModified})
    </insert>

    <delete id="deleteByGroupId">
        DELETE FROM user_group_tag WHERE group_id = #{groupId}
    </delete>

    <select id="selectByGroupId" resultMap="UserGroupTagResultMap">
        SELECT * FROM user_group_tag WHERE group_id = #{groupId} ORDER BY sort_order ASC
    </select>

    <select id="selectByTagId" resultMap="UserGroupTagResultMap">
        SELECT * FROM user_group_tag WHERE tag_id = #{tagId} ORDER BY sort_order ASC
    </select>

</mapper>
